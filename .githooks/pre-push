#!/usr/bin/env bash
#
# The attestation, before a push leaves this machine.
#
# CI's `attest` job refuses a commit no recorded ./verify.sh run covers. It is
# the only gate that binds a person, and it fires after the push — so a commit
# made from a terminal on a red or absent run is on origin before anyone hears.
# This asks the same question a few seconds earlier, for each commit being
# pushed, in a detached worktree of exactly that commit so an uncommitted edit
# in the working tree cannot change the answer either way.
#
# Installed by `pnpm prepare` (core.hooksPath = .githooks). Bypass, when the
# gate is wrong: `git push --no-verify`. That is a visible act, which is the
# point.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
status=0

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ -z "$local_sha" || "$local_sha" == "$zero" ]] && continue
  tmp="$(mktemp -d)"
  git -C "$root" worktree add --detach --quiet "$tmp" "$local_sha"
  echo "pre-push: attesting $(git -C "$root" log -1 --format='%h %s' "$local_sha")"
  if ! node "$tmp/scripts/check-attestation.mjs"; then
    status=1
  fi
  git -C "$root" worktree remove --force "$tmp"
done

if [[ $status -ne 0 ]]; then
  echo "pre-push: refused. Run ./verify.sh and commit again, or push with --no-verify to overrule." >&2
fi
exit $status
